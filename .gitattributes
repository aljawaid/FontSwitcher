# Normalise text files to LF while preserving known binary formats.
* text=auto eol=lf

*.svg  text eol=lf

*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary

# Keep manifest-covered text assets byte-identical on every checkout.
.gitattributes text eol=lf
Assets/fonts/**/*.css text eol=lf
Assets/fonts/**/*.txt text eol=lf
Assets/fonts/SHA256SUMS text eol=lf
Releases/SHA256SUMS text eol=lf
